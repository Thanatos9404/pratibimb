# Data source: demo (default) | api | mock
#   demo -> static engine export in public/demo (falls back to public/mock)
#   api  -> live FastAPI engine at NEXT_PUBLIC_API_BASE (falls back to demo, then mock)
#   mock -> development fixtures from `npm run mocks`
NEXT_PUBLIC_DATA_SOURCE=demo

# Live engine base URL (only used when NEXT_PUBLIC_DATA_SOURCE=api). The engine must allow this
# site's origin via PRATIBIMB_CORS_ORIGINS.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional: canonical site URL (Open Graph) and public repository link shown in the footer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=
